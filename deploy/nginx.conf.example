# Include in nginx's http context. Replace demo.example.org and certificate paths.
# Direct-to-origin example: if another proxy is used, configure only its verified
# addresses as trusted real-IP sources; never trust arbitrary forwarded headers.
limit_req_zone $binary_remote_addr zone=tradepilot_ip:10m rate=2r/s;
limit_conn_zone $binary_remote_addr zone=tradepilot_connections:10m;

server {
    listen 80;
    server_name demo.example.org;
    return 301 https://demo.example.org$request_uri;
}
server {
    listen 443 ssl;
    server_name demo.example.org;
    ssl_certificate /etc/letsencrypt/live/demo.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/demo.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 16k;
    client_body_timeout 10s;
    limit_req_status 429;
    limit_conn_status 429;
    # Do not log cookies, tokens, bodies or query-string record identifiers.
    access_log off;
    location / {
        limit_req zone=tradepilot_ip burst=20 nodelay;
        limit_conn tradepilot_connections 10;
        proxy_pass http://127.0.0.1:8780;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Connection "";
        proxy_read_timeout 45s;
        proxy_send_timeout 15s;
        proxy_buffering off;
    }
}
